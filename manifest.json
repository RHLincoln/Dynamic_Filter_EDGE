{
  "manifest_version": 3,
  "name": "DynamicSearchLiteSafe",
  "version": "3.1.0",
  "description": "Dynamic in-page search with highlights for enterprise Edge users.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "DynamicSearchLiteSafe"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"]
}
